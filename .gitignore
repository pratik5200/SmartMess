# ==========================================
# Dependencies & Package Managers
# ==========================================
**/node_modules/
**/.pnp
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# ==========================================
# Strict Environment & Secret Protection
# ==========================================
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env*
**/*.env

# ==========================================
# Security Keys, Certificates & DB Dumps
# ==========================================
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/*.pfx
**/*.p12
**/*.sql
**/*.dump
**/*.sqlite
**/*.sqlite3

# ==========================================
# Local Uploads & Media Storage (Prevent Data Leaks)
# ==========================================
**/uploads/
**/.tempmediaStorage/
**/.user_uploaded/

# ==========================================
# Build Outputs & Framework Caches
# ==========================================
**/.next/
**/out/
**/build/
**/dist/
**/*.tsbuildinfo
next-env.d.ts

# ==========================================
# PWA & Service Worker (Auto-generated by Next-PWA)
# ==========================================
**/public/sw.js
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/worker-*.js
**/public/worker-*.js.map
**/public/swe-worker-*.js
**/public/swe-worker-*.js.map
**/public/fallback-*.js

# ==========================================
# Debug & Log Files
# ==========================================
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/logs/
**/*.log

# ==========================================
# OS & System Artifacts
# ==========================================
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# ==========================================
# AI IDE & Workspace Folders
# ==========================================
.agents/
**/.agents/
.gemini/
**/.gemini/
.cursor/
**/.cursor/
.vscode/
**/.vscode/
.idea/
**/.idea/
.windsurf/
**/.windsurf/
